# ── LLM Provider Configuration ──────────────────────────────────────────────
# The script uses the OpenAI SDK, which is compatible with many providers.
# Set LLM_API_KEY (or fall back to OPENAI_API_KEY) and optionally LLM_BASE_URL.
#
# Examples:
#   OpenAI (default) — just set the key, no base URL needed
#   Ollama           — LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3
#   Together AI      — LLM_BASE_URL=https://api.together.xyz/v1
#   Groq             — LLM_BASE_URL=https://api.groq.com/openai/v1
#   Anyscale / vLLM / LiteLLM — set your provider's /v1 endpoint

# Required: API key (LLM_API_KEY takes precedence over OPENAI_API_KEY)
OPENAI_API_KEY=sk-your-key-here
# LLM_API_KEY=sk-your-key-here

# Optional: base URL for non-OpenAI providers
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: override model from interests.json
# LLM_MODEL=gpt-4o-mini
