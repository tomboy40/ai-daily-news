---
/**
 * Server-rendered component that fetches the latest daily report from the
 * Astro content collection and renders the Markdown directly at build time.
 *
 * No client-side JavaScript or JSON fetching required.
 */
import { getCollection, render } from 'astro:content';
import CategoryFilter from './CategoryFilter.astro';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPost = posts[0];
let RenderedContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;
const tags: string[] = latestPost?.data.tags ?? [];
const zhTagLabels: Record<string, string> = {
	'Artificial Intelligence': '人工智能',
	'Software Engineering': '软件工程',
	'Science & Space': '科学与太空',
};
const englishFilters = tags.map((tag) => ({ label: tag, match: tag }));
const chineseFilters = tags.map((tag) => ({
	label: zhTagLabels[tag] ?? tag,
	match: zhTagLabels[tag] ?? tag,
}));

if (latestPost) {
	const rendered = await render(latestPost);
	RenderedContent = rendered.Content;
}
---

<section id="daily-news">
	{
		latestPost && RenderedContent ? (
			<article class="daily-report">
				<div class="report-header">
					<p class="report-kicker" data-lang-group="en">Latest Edition</p>
					<p class="report-kicker" data-lang-group="zh" hidden>最新一期</p>
					<h2>{latestPost.data.title}</h2>
					<p class="report-date" data-lang-group="en">
						<FormattedDate date={latestPost.data.pubDate} />
					</p>
					<p class="report-date" data-lang-group="zh" hidden>
						<FormattedDate date={latestPost.data.pubDate} />
					</p>
				</div>
				<CategoryFilter items={englishFilters} lang="en" allLabel="All News" label="Sections" />
				<CategoryFilter items={chineseFilters} lang="zh" allLabel="全部" label="栏目" />
				<div class="daily-report-body">
					<div class="prose prose-source" data-news-source>
						<RenderedContent />
					</div>
					<div class="prose prose-language" data-news-panel="en" data-lang-group="en"></div>
					<div class="prose prose-language" data-news-panel="zh" data-lang-group="zh" hidden></div>
				</div>
			</article>
		) : (
			<p class="news-status">No report available yet. Check back tomorrow!</p>
		)
	}
</section>

<script>
	function initDailyNewsPanels() {
		const source = document.querySelector<HTMLElement>('[data-news-source]');
		const englishPanel = document.querySelector<HTMLElement>('[data-news-panel="en"]');
		const chinesePanel = document.querySelector<HTMLElement>('[data-news-panel="zh"]');
		if (!source || !englishPanel || !chinesePanel || source.dataset.partitioned === 'true') return;

		const englishNodes: Node[] = [];
		const chineseNodes: Node[] = [];
		let currentLanguage: 'en' | 'zh' = 'en';

		Array.from(source.childNodes).forEach((node) => {
			if (
				node.nodeType === Node.ELEMENT_NODE &&
				/^H[1-6]$/.test((node as HTMLElement).tagName) &&
				((node.textContent?.includes('中文版') ?? false) ||
					(node.textContent?.includes('Chinese Translation') ?? false))
			) {
				if (englishNodes.at(-1) instanceof HTMLElement && englishNodes.at(-1)?.nodeName === 'HR') {
					englishNodes.pop();
				}
				currentLanguage = 'zh';
				return;
			}

			if (currentLanguage === 'en') {
				englishNodes.push(node.cloneNode(true));
			} else {
				chineseNodes.push(node.cloneNode(true));
			}
		});

		englishPanel.replaceChildren(...englishNodes);
		chinesePanel.replaceChildren(...chineseNodes);
		source.hidden = true;
		source.dataset.partitioned = 'true';
	}

	initDailyNewsPanels();
	document.addEventListener('astro:after-swap', initDailyNewsPanels);
</script>

<style>
	.news-status {
		text-align: center;
		color: var(--text-muted);
		font-style: italic;
	}

	.daily-report {
		max-width: 760px;
		margin: 0 auto;
		background: var(--bg-card);
		border: 1px solid var(--border-light);
		border-top: 0;
		padding: 3rem;
	}

	.report-header {
		text-align: center;
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-light);
	}

	.report-kicker {
		margin: 0 0 0.5rem;
		font-family: var(--font-utility);
		font-size: 0.7rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.report-header h2 {
		margin: 0 0 0.4rem;
		font-size: clamp(2.2rem, 6vw, 3.25rem);
	}

	.report-date {
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-utility);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.daily-report-body {
		position: relative;
	}

	.prose {
		color: var(--text-main);
		line-height: 1.7;
	}

	.prose :global(h2) {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-light);
	}

	.prose :global(h3) {
		margin-top: 1.75rem;
	}

	.prose :global(a) {
		color: var(--accent);
	}

	.prose :global(hr) {
		margin: 1.5rem 0;
	}

	@media (max-width: 720px) {
		.daily-report {
			padding: 1.5rem;
		}
	}
</style>
