---
/**
 * Server-rendered component that fetches the latest daily report from the
 * Astro content collection and renders the Markdown directly at build time.
 *
 * No client-side JavaScript or JSON fetching required.
 */
import { getCollection, render } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPost = posts[0];
let RenderedContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;

if (latestPost) {
	const rendered = await render(latestPost);
	RenderedContent = rendered.Content;
}
---

<section id="daily-news">
	{
		latestPost && RenderedContent ? (
			<article class="daily-report">
				<div class="report-header">
					<h2>{latestPost.data.title}</h2>
					<p class="report-date">
						<FormattedDate date={latestPost.data.pubDate} />
					</p>
				</div>
				<div class="prose">
					<RenderedContent />
				</div>
			</article>
		) : (
			<p class="news-status">No report available yet. Check back tomorrow!</p>
		)
	}
</section>

<style>
	.news-status {
		text-align: center;
		color: rgb(var(--gray));
		font-style: italic;
	}
	.daily-report {
		max-width: 720px;
		margin: 0 auto;
	}
	.report-header {
		text-align: center;
		margin-bottom: 1.5rem;
	}
	.report-header h2 {
		margin: 0 0 0.25rem;
	}
	.report-date {
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.prose {
		color: rgb(var(--gray-dark));
		line-height: 1.7;
	}
	.prose :global(h2) {
		margin-top: 2rem;
	}
	.prose :global(h3) {
		margin-top: 1.5rem;
	}
	.prose :global(a) {
		color: var(--accent);
	}
	.prose :global(blockquote) {
		border-left: 3px solid rgb(var(--gray-light));
		padding-left: 1rem;
		color: rgb(var(--gray));
		font-style: italic;
	}
</style>
