---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="footer-note">&copy; {today.getFullYear()} AI Daily News</p>
		<nav aria-label="Footer">
			<a href={import.meta.env.BASE_URL}>Home</a>
			<a href={`${import.meta.env.BASE_URL}blog/`}>Blog Archive</a>
			<a href="https://github.com/tomboy40/ai-daily-news" target="_blank" rel="noreferrer">GitHub</a>
			<a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
		</nav>
	</div>
</footer>
<style>
	footer {
		padding: 0 1rem 3rem;
	}

	.footer-inner {
		width: min(760px, calc(100% - 2rem));
		margin: 0 auto;
		padding-top: 1rem;
		border-top: 1px solid var(--border-light);
		font-family: var(--font-utility);
		font-size: 0.9rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.footer-note {
		margin: 0;
		color: var(--text-muted);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	nav a {
		color: var(--accent);
		text-decoration: none;
	}

	nav a:hover {
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
