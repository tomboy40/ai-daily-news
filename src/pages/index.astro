---
import BaseHead from '../components/BaseHead.astro';
import DailyNews from '../components/DailyNews.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Today's AI News</h1>
			<p class="subtitle">
				Your AI-curated daily briefing — automatically generated and updated every day.
			</p>
			<DailyNews />
			<p class="archive-link">
				Looking for older briefings? Check the <a href={`${import.meta.env.BASE_URL}blog/`}>blog archive</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		text-align: center;
		margin-bottom: 0.25rem;
	}
	.subtitle {
		text-align: center;
		color: rgb(var(--gray));
		margin-bottom: 2rem;
	}
	.archive-link {
		text-align: center;
		margin-top: 2rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
</style>
